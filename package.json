{
  "name": "orbital-wallet-provider",
  "version": "1.0.1",
  "description": "React provider and hooks for connecting to the Orbital Wallet Chrome extension",
  "author": "blademaster888",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "logo.svg"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "radiant",
    "rxd",
    "orbital",
    "wallet",
    "web3",
    "react",
    "provider",
    "glyph",
    "nft",
    "blockchain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blademaster-888/orbital-wallet-provider.git"
  }
}